{
  "project": {
    "name": "dpm",
    "title": "DPM",
    "description": "A open-source package manager for Delphi",
    "copyright": "Copyright © 2023 - present {{dpm.team}}. All Rights Reserved.",
    "homepage": "https://delphi.dev",
    "repository": "https://github.com/DelphiPackageManager/DPM"
  },
  "variables": {
    "dpm": {
      "team": {
        "type": "link",
        "label": "DPM Dev Team",
        "href": "https://github.com/DelphiPackageManager"
      }
    },
    "vsoft": {
      "type": "link",
      "label": "VSoft Technologies Pty Ltd",
      "href": "https://www.finalbuilder.com/"
    },
    "showcase_repo": {
      "type": "link",
      "label": "showcase repository",
      "href": "https://github.com/docinsight/dpm/"
    }
  },
  "sources": {
    "main": {
      "type": "delphi",
      "files": [
        "Source/dpm.dproj"
      ],
      "options": {
        "compiler": "delphi_13",
        "platform": "Win32"
      }
    }
  },
  "content": {
    "guide": {
      "title": "Guide",
      "type": "markdown",
      "root": "docs/guide",
      "mount": "/"
    },
    "reference": {
      "title": "Code Reference",
      "type": "delphi",
      "source": "main",
      "structure": {
        "path": {
          "project": "none"
        }
      }
    }
  },
  "site": {
    "title": "DPM Showcase",
    "title_suffix": " | DocInsight Showcase",
    "description": "Unofficial DocInsight documentation showcase for DPM, an open-source package manager for Delphi.",
    "base_path": "/dpm/",
    "robots": "noindex,follow",
    "footer": {
      "notice": "Unofficial DocInsight showcase for {{dpm.homepage}}. This showcase is not affiliated with, sponsored by, or endorsed by the {{dpm.team}} or {{vsoft}}.\nDPM source and documentation are copyright © 2023–present DPM Dev Team and licensed under the Apache License 2.0.\nBuilt with {{sys.docinsight}}. View the {{showcase_repo}}."
    }
  },
  "output": {
    "default_targets": [
      "site"
    ],
    "targets": {
      "site": {
        "type": "html",
        "path": "dist/docs/site",
        "content": [
          "guide",
          "reference"
        ]
      }
    }
  }
}