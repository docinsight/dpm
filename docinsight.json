{
  "project": {
    "name": "dpm",
    "title": "DPM",
    "variable_alias": "dpm",
    "description": "A open-source package manager for Delphi",
    "copyright": "Copyright © 2023 - present {{dpm.team}}. All Rights Reserved.",
    "homepage": "https://delphi.dev",
    "repository": "https://github.com/DelphiPackageManager/DPM"
  },
  "variables": {
    "dpm": {
      "team": {
        "type": "link",
        "label": "DPM Dev Team",
        "href": "https://github.com/DelphiPackageManager"
      }
    },
    "vsoft": {
      "type": "link",
      "label": "VSoft Technologies Pty Ltd.",
      "href": "https://www.finalbuilder.com/"
    }
  },
  "sources": {
    "main": {
      "type": "delphi",
      "files": [
        "Source/dpm.dproj"
      ],
      "options": {
        "compatibility": "delphi_13",
        "platform": "Win32"
      }
    }
  },
  "content": {
    "guide": {
      "title": "Guide",
      "type": "markdown",
      "root": "docs/guide",
      "mount": "/"
    },
    "reference": {
      "title": "Code Reference",
      "type": "delphi",
      "source": "main",
      "structure": {
        "path": {
          "prefix": "none"
        }
      }
    }
  },
  "site": {
    "title": "DPM Docs",
    "title_suffix": " | DocInsight Showcase",
    "description": "Unofficial DocInsight documentation showcase for DPM, an open-source package manager for Delphi.",
    "robots": "noindex,follow",
    "footer": {
      "notice": "Unofficial DocInsight showcase for {{dpm.homepage}}. This showcase is not affiliated with, sponsored by, or endorsed by the {{dpm.team}} or {{vsoft}}.\n{{dpm.copyright}}\nBuilt with {{docinsight}}."
    }
  },
  "output": {
    "default_targets": [
      "site"
    ],
    "targets": {
      "site": {
        "type": "html",
        "path": "dist/docs/site",
        "content": [
          "guide",
          "reference"
        ]
      }
    }
  }
}